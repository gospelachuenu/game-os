<UserControl x:Class="UI.OnScreenKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!--
        Controller-driven text entry. Needed anywhere the console asks for text it cannot
        get any other way: a web address, a wifi password, a search term. The console has
        no keyboard by default, so without this those are simply unreachable.

        A grid of keys navigated with the D-pad. Deliberately NOT a phone-style predictive
        keyboard — from a sofa, a fixed grid you can learn the shape of beats anything
        that moves under you.
    -->
    <Grid Background="#D8060709">
        <Border MaxWidth="900" VerticalAlignment="Center" HorizontalAlignment="Center"
                CornerRadius="18" Background="#F20E1016" BorderBrush="#2A2F3A"
                BorderThickness="1" Padding="34,30">
            <StackPanel>
                <TextBlock x:Name="PromptText" Text="Enter address" FontSize="11"
                           FontWeight="Bold" Margin="0,0,0,12"
                           Foreground="{DynamicResource Theme.AccentPrimaryBrush}"/>

                <!-- What has been typed so far, with a blinking caret so it is obvious
                     the field is live rather than a label. -->
                <Border CornerRadius="10" Background="#B8080A0F" BorderBrush="#2A2F3A"
                        BorderThickness="1.5" Padding="18,14" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="EntryText" Text="" FontSize="19"
                                   Foreground="#F2F4F0" TextTrimming="CharacterEllipsis"/>
                        <Rectangle x:Name="Caret" Width="2" Height="22" Margin="1,0,0,0"
                                   Fill="{DynamicResource Theme.AccentPrimaryBrush}">
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="Rectangle.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0" Duration="0:0:0.55"
                                                             AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                    </StackPanel>
                </Border>

                <!-- The key grid. Built in code so the layout can change with the shift
                     state without duplicating every row in markup. -->
                <ItemsControl x:Name="KeyRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="KeyCap" Width="{Binding Width}" Height="52"
                                                Margin="4" CornerRadius="9"
                                                Background="#14FFFFFF" BorderBrush="Transparent"
                                                BorderThickness="2" Cursor="Hand"
                                                Tag="{Binding}" MouseLeftButtonUp="Key_Click">
                                            <TextBlock Text="{Binding Label}" FontSize="16"
                                                       Foreground="#E8EAE6"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                                <Setter TargetName="KeyCap" Property="BorderBrush"
                                                        Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                                                <Setter TargetName="KeyCap" Property="Background"
                                                        Value="#26A8E03B"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="HintText" FontSize="12" Foreground="#5A606A"
                           HorizontalAlignment="Center" Margin="0,16,0,0"
                           Text="D-pad  Move        A  Press        X  Backspace        Y  Shift        MENU  Done"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
