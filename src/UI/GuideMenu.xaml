<UserControl x:Class="UI.GuideMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" x:Name="Root" IsHitTestVisible="False">
    <!--
        Quick-access side menu per plan.md §9.1: a slide-out panel over the right side
        of the screen, on top of whatever's active underneath (dashboard or the
        launch overlay). Toggled by Tab in this test build (stands in for the real
        gamepad Guide/Home button — no physical controller Guide button on this dev
        laptop to bind to). Contains a volume slider, display backlight slider, an
        overlay toggle, and a system status card (clock, battery, network state).
    -->
    <Grid>
        <!-- Dimming scrim behind the panel; only intercepts clicks while the menu is open. -->
        <Rectangle x:Name="Scrim" Fill="#00000000" Opacity="0" IsHitTestVisible="False"/>

        <Border x:Name="Panel" Width="340" HorizontalAlignment="Right"
                Background="#F0121016" BorderBrush="#1FFFFFFF" BorderThickness="1,0,0,0"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelTransform" X="340"/>
            </Border.RenderTransform>

            <StackPanel Margin="26,34,26,0">
                <TextBlock Text="QUICK ACCESS" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource Theme.AccentPrimaryBrush}" Margin="0,0,0,24"/>

                <!-- System status card -->
                <Border CornerRadius="14" Background="#0FFFFFFF" Padding="18" Margin="0,0,0,22">
                    <StackPanel>
                        <TextBlock x:Name="ClockText" Text="--:--" FontSize="26" FontWeight="Bold"
                                   Foreground="White" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Battery" Foreground="#8A8A96" FontSize="12" Width="90"/>
                            <TextBlock Text="{Binding BatteryIcon.Label, ElementName=Root}"
                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Network" Foreground="#8A8A96" FontSize="12" Width="90"/>
                            <TextBlock Text="Connected" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Volume -->
                <TextBlock Text="VOLUME" FontSize="11" FontWeight="Bold" Foreground="#6E6E7D" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="65"
                            IsHitTestVisible="False" IsEnabled="False"/>
                    <TextBlock Grid.Column="1" Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat={}{0:0}%}"
                               Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Display backlight -->
                <TextBlock Text="DISPLAY BACKLIGHT" FontSize="11" FontWeight="Bold" Foreground="#6E6E7D" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="BacklightSlider" Minimum="0" Maximum="100" Value="80"
                            IsHitTestVisible="False" IsEnabled="False"/>
                    <TextBlock Grid.Column="1" Text="{Binding ElementName=BacklightSlider, Path=Value, StringFormat={}{0:0}%}"
                               Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- Overlay toggle -->
                <Border CornerRadius="12" Background="#0FFFFFFF" Padding="16,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Performance Overlay" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" x:Name="OverlayPill" Width="42" Height="22" CornerRadius="11" Background="#2A2A33">
                            <Border x:Name="OverlayKnob" Width="16" Height="16" CornerRadius="8" Background="White"
                                    HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                    </Grid>
                </Border>

                <!--
                    Controller setup: navigable by gamepad, not just mouse.
                    GuideMenu.xaml.cs tracks a selected index (always 0, the only
                    action item now that Updates moved to its own dedicated rail
                    button — see MainWindow.xaml's left rail); MainWindow routes
                    gamepad Up/Down/Confirm into MoveSelection/ActivateSelected while
                    the menu is open, mirroring how tile focus works on the
                    dashboard. The highlight (accent border + faint tint) uses the
                    same visual language as LibraryCardStyle's focused state.
                -->
                <Button x:Name="ControllerSetupButton" Click="ControllerSetupButton_Click"
                        Cursor="Hand" IsHitTestVisible="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="12" Background="#0FFFFFFF"
                                    BorderThickness="1" BorderBrush="Transparent" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Set Up Controller" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="&#8250;" Foreground="#6E6E7D" FontSize="16" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding SelectedActionIndex, ElementName=Root}" Value="0">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.AccentPrimaryFaintTintBrush}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
