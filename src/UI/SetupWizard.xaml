<UserControl x:Class="UI.SetupWizard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UI"
             Visibility="Collapsed">

    <UserControl.Resources>

        <!-- Selectable row: language options, networks, controller slots. Highlight
             defaults live in Setters (NOT as local attributes on the Border) because
             a local value beats a style trigger in WPF precedence and the trigger
             would silently never apply. -->
        <Style x:Key="SetupRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#B80E1016"/>
            <Setter Property="BorderBrush" Value="#2A2F3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SetupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F4F0"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="SetupKickerStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
        </Style>

        <Style x:Key="SetupSubStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#8A9099"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="520"/>
            <!-- MaxWidth alone leaves the (narrower) text box centred in the row's
                 full width, which floated the subtitle into the middle of the screen
                 instead of sitting under the title. -->
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="Root" Background="#14171C" MouseLeftButtonUp="Root_Click">

        <!-- Bouncing shape field. Setup runs before the dashboard exists, so this
             stands in for the ambient video rather than sitting on top of it. -->
        <local:ShapeFieldBackground x:Name="Shapes"/>

        <!-- Each step occupies the same cell; only one is visible at a time. -->
        <Grid x:Name="Stage" Margin="72,60,72,0">

            <!-- ============ STEP 1 — LANGUAGE ============ -->
            <StackPanel x:Name="StepLanguage" Visibility="Visible">
                <TextBlock Style="{StaticResource SetupKickerStyle}" Text="SETUP · STEP 1 OF 4"/>
                <TextBlock Style="{StaticResource SetupTitleStyle}" Text="Choose your language"/>
                <TextBlock Style="{StaticResource SetupSubStyle}" Text="You can change this later in Settings."/>

                <ItemsControl x:Name="LanguageList" Margin="0,32,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Cursor + click handler so the wizard is usable with a
                                 mouse. The console itself has none, but the test build
                                 is driven on a laptop and in a VM where a controller
                                 isn't always to hand. -->
                            <Border x:Name="RowBorder" Style="{StaticResource SetupRowStyle}"
                                    Cursor="Hand" MouseLeftButtonUp="LanguageRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               FontSize="15" Foreground="#F2F4F0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Tick" Grid.Column="1" Text="✓"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource Theme.AccentPrimaryBrush}"
                                               Visibility="Collapsed" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                    <Setter TargetName="RowBorder" Property="BorderBrush"
                                            Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                                    <Setter TargetName="RowBorder" Property="Background" Value="#1FA8E03B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ============ STEP 2 — NETWORK ============ -->
            <StackPanel x:Name="StepNetwork" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SetupKickerStyle}" Text="SETUP · STEP 2 OF 4"/>
                <TextBlock Style="{StaticResource SetupTitleStyle}" Text="Choose your network"/>
                <TextBlock x:Name="NetworkSubtitle" Style="{StaticResource SetupSubStyle}"
                           Text="Looking for networks nearby…"/>

                <ItemsControl x:Name="NetworkList" Margin="0,32,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBorder" Style="{StaticResource SetupRowStyle}"
                                    Cursor="Hand" MouseLeftButtonUp="NetworkRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Signal bars: four rectangles of increasing height,
                                         lit according to SignalBars. -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,14,0" Height="13">
                                        <Rectangle Width="3" Height="4" Margin="0,0,2,0" VerticalAlignment="Bottom"
                                                   Fill="{Binding Bar1Brush}" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Width="3" Height="7" Margin="0,0,2,0" VerticalAlignment="Bottom"
                                                   Fill="{Binding Bar2Brush}" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Width="3" Height="10" Margin="0,0,2,0" VerticalAlignment="Bottom"
                                                   Fill="{Binding Bar3Brush}" RadiusX="1" RadiusY="1"/>
                                        <Rectangle Width="3" Height="13" VerticalAlignment="Bottom"
                                                   Fill="{Binding Bar4Brush}" RadiusX="1" RadiusY="1"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Ssid}"
                                               FontSize="15" Foreground="#F2F4F0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusLabel}"
                                               FontSize="13" Foreground="#8A9099" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                    <Setter TargetName="RowBorder" Property="BorderBrush"
                                            Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                                    <Setter TargetName="RowBorder" Property="Background" Value="#1FA8E03B"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Shown only while a connection attempt is in flight or has failed. -->
                <TextBlock x:Name="NetworkStatus" Margin="0,18,0,0" FontSize="14"
                           Foreground="{DynamicResource Theme.AccentPrimaryBrush}" Visibility="Collapsed"/>
            </StackPanel>

            <!-- ============ STEP 3 — CONTROLLER ============ -->
            <StackPanel x:Name="StepController" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SetupKickerStyle}" Text="SETUP · STEP 3 OF 4"/>
                <TextBlock Style="{StaticResource SetupTitleStyle}" Text="Connect a controller"/>
                <TextBlock Style="{StaticResource SetupSubStyle}"
                           Text="Press any button on your controller to confirm it. You can connect one later if you don't have it to hand."/>

                <ItemsControl x:Name="ControllerList" Margin="0,32,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBorder" Style="{StaticResource SetupRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                               FontSize="15" Foreground="#F2F4F0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusLabel}"
                                               FontSize="13" Foreground="#8A9099" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                                    <Setter TargetName="RowBorder" Property="BorderBrush"
                                            Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                                    <Setter TargetName="RowBorder" Property="Background" Value="#1FA8E03B"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ============ STEP 4 — PARENT PIN ============ -->
            <StackPanel x:Name="StepPin" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SetupKickerStyle}" Text="SETUP · STEP 4 OF 4"/>
                <TextBlock Style="{StaticResource SetupTitleStyle}" Text="Create a parent PIN"/>
                <TextBlock Style="{StaticResource SetupSubStyle}"
                           Text="For approving new games and changing settings. Keep it away from the kids."/>

                <!-- Entered digits -->
                <StackPanel x:Name="PinBoxes" Orientation="Horizontal" Margin="0,32,0,0"/>

                <!-- Phone-style 3x4 keypad: 1-9, then blank / 0 / delete. A horizontal
                     strip of 11 keys was unusable on a D-pad — this puts the digits
                     where anyone already expects them and makes up/down mean something
                     instead of every key sitting on one line. -->
                <ItemsControl x:Name="PinPad" Margin="0,30,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="KeyBorder" Width="62" Height="56" Margin="0,0,10,10"
                                    Background="#B80E1016" BorderBrush="#2A2F3A" BorderThickness="1"
                                    CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="PinKey_Click">
                                <TextBlock Text="{Binding Label}" FontSize="21" Foreground="#F2F4F0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                    <Setter TargetName="KeyBorder" Property="BorderBrush"
                                            Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                                    <Setter TargetName="KeyBorder" Property="Background" Value="#1FA8E03B"/>
                                </DataTrigger>
                                <!-- The spacer left of 0 keeps the grid square without
                                     being a key: no border, and focus skips over it. -->
                                <DataTrigger Binding="{Binding IsSpacer}" Value="True">
                                    <Setter TargetName="KeyBorder" Property="Background" Value="Transparent"/>
                                    <Setter TargetName="KeyBorder" Property="BorderThickness" Value="0"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="PinStatus" Margin="0,20,0,0" FontSize="14"
                           Foreground="#FF7A4A" Visibility="Collapsed"/>
            </StackPanel>

        </Grid>

        <!-- Closing panel: replaces the steps once the PIN is set, so setup doesn't
             drop straight from a button press into a live dashboard. The shapes keep
             bouncing behind it. -->
        <StackPanel x:Name="Closing" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- A determinate bar, not a spinner. There are real steps behind this
                 (settings written, library scanned, controllers registered) and the
                 code reports each one as it lands, so the fill tracks actual progress
                 rather than a shape turning on a timer. -->
            <Border x:Name="ReadyBarTrack" Width="300" Height="3" CornerRadius="2"
                    Background="#2A2F3A" HorizontalAlignment="Center">
                <Border x:Name="ReadyBarFill" Width="0" HorizontalAlignment="Left"
                        CornerRadius="2" Background="{DynamicResource Theme.AccentPrimaryBrush}"/>
            </Border>

            <TextBlock x:Name="ClosingTitle" Text="Getting everything ready" FontSize="26"
                       FontWeight="SemiBold" Foreground="#F2F4F0"
                       HorizontalAlignment="Center" Margin="0,26,0,0"/>
            <TextBlock x:Name="ClosingCaption" Text="Saving your settings…" FontSize="15"
                       Foreground="#8A9099" HorizontalAlignment="Center" Margin="0,10,0,0"/>

            <!-- Shown once the work is done: nothing proceeds until the user acts, so
                 the console never drops them into the dashboard unannounced. -->
            <TextBlock x:Name="ReadyPrompt" Visibility="Collapsed"
                       Text="Press any button to continue" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.AccentPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Step dots, Next button and button hints, pinned to the bottom across all
             steps.

             Next exists so choosing an option and COMMITTING to it are separate acts.
             Selecting used to advance immediately, which meant you never saw what you
             had picked and a mis-click cost you a step. Applies to the controller too,
             not just the mouse: a highlight you can see before confirming is clearer
             either way. -->
        <Grid x:Name="BottomChrome" VerticalAlignment="Bottom" Margin="72,0,72,44">
            <StackPanel x:Name="StepDots" Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock x:Name="ButtonHints" FontSize="13" Foreground="#5A606A"
                           VerticalAlignment="Center" Margin="0,0,22,0"
                           Text="A  Select        B  Back"/>

                <Border x:Name="NextButton" Cursor="Hand" CornerRadius="8"
                        Padding="30,11" BorderThickness="1.5"
                        Background="{DynamicResource Theme.AccentPrimaryBrush}"
                        BorderBrush="{DynamicResource Theme.AccentPrimaryBrush}"
                        MouseLeftButtonUp="NextButton_Click">
                    <TextBlock x:Name="NextButtonText" Text="Next" FontSize="15" FontWeight="SemiBold"
                               Foreground="#06070B"/>
                </Border>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
