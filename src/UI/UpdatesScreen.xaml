<UserControl x:Class="UI.UpdatesScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UI"
             mc:Ignorable="d" x:Name="Root" Visibility="Collapsed">
    <!--
        Updates screen: full-screen overlay reached from its own dedicated rail
        button (separate from the Library/Foundry/Friends/Settings rail items),
        listing pending Windows Updates and AMD driver updates side by side with mock
        patch notes. Mock data only in this test build (see UpdatesScreenViewModel) —
        the real screen would be backed by MaintenanceHub, which on real hardware
        would call the Windows Update Agent API for both update classes.
    -->
    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:DownloadingToVisibilityConverter x:Key="DownloadingToVisibilityConverter"/>
        <local:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
        <local:PercentToStarConverter x:Key="PercentToStarConverter"/>
        <local:PercentToRemainingStarConverter x:Key="PercentToRemainingStarConverter"/>

        <Style x:Key="UpdateCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Theme.AccentPrimaryFaintTintBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatePillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Padding="26,14"
                                Background="{DynamicResource Theme.AccentPrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Padding="22,13"
                                Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        Semi-transparent dark scrim, NOT flat black — the home screen's ambient video
        keeps playing behind this (MainWindow only hides ContentGrid, the game rows,
        not Ambient). The scrim just darkens the video enough to keep the update cards
        and patch notes readable, the same way the hero card's gradient does on the
        dashboard, so switching to Updates reuses the exact same moving background.
    -->
    <Grid Background="#66060709">
        <!-- MaxHeight + ClipToBounds keep the whole two-pane body inside the window
             frame; the detail panel's own patch-notes ScrollViewer (Row 4) absorbs
             any content overflow so the action buttons (Row 5) never slide off the
             bottom of the frame. -->
        <Grid MaxWidth="1180" Margin="60,44,60,44" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SYSTEM" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource Theme.AccentPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Updates" FontSize="34" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding LastCheckedLabel}" FontSize="13" Foreground="#8A8A96" Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="12" Background="#0FFFFFFF" Padding="18,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AvailableCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.AccentPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" pending" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!--
                Body: HERO left, queue right — same rhythm as the Spotlight home
                screen. The selected update is the big thing on screen; the queue is a
                compact supporting list. Moving up/down the queue swaps the hero.
            -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- Update queue (right column) -->
                <ScrollViewer x:Name="ListScrollViewer" Grid.Column="2" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="UpdatesItemsControl" ItemsSource="{Binding Updates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource UpdateCardStyle}"
                                        Tag="{Binding}"
                                        MouseLeftButtonDown="UpdateCard_MouseLeftButtonDown">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding KindLabel}" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="#8A8A96"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                   Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                                <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" Foreground="#B8B8C2" FontSize="12"/>
                                                <Run Text=" · " Foreground="#4A4A54" FontSize="12"/>
                                                <Run Text="{Binding SizeLabel, Mode=OneWay}" Foreground="#8A8A96" FontSize="12"/>
                                            </TextBlock>
                                            <Border Grid.Column="1">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatePillStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Installed">
                                                                <Setter Property="Background" Value="#1E33D17A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="ReadyToInstall">
                                                                <Setter Property="Background" Value="{DynamicResource Theme.AccentPrimaryFaintTintBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                                <Setter Property="Background" Value="#1EF5B72E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#B8B8C2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Installed">
                                                                    <Setter Property="Foreground" Value="#33D17A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="ReadyToInstall">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Theme.AccentPrimaryBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                                    <Setter Property="Foreground" Value="#F5B72E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>

                                        <!-- Download progress (only meaningful while Downloading); uses the SAME full-width star-fill approach as the detail panel so the two bars scale identically. -->
                                        <Border Height="4" CornerRadius="4" Background="#14FFFFFF" Margin="0,12,0,0"
                                                Visibility="{Binding State, Converter={StaticResource DownloadingToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding DownloadProgressPercent, Converter={StaticResource PercentToStarConverter}}"/>
                                                    <ColumnDefinition Width="{Binding DownloadProgressPercent, Converter={StaticResource PercentToRemainingStarConverter}}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Height="4" CornerRadius="4" Background="#F5B72E"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- HERO: the selected update, at Spotlight scale. No card chrome —
                     it sits directly on the background like the home screen's hero. -->
                <Border Grid.Column="0" Padding="0,4,0,0"
                        DataContext="{Binding SelectedUpdate}"
                        Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding KindLabel}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.AccentPrimaryBrush}" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="40" FontWeight="Bold"
                                   Foreground="White" TextWrapping="Wrap" LineHeight="42" Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="2" Margin="0,0,0,26">
                            <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" Foreground="#B8B8C2" FontSize="13"/>
                            <Run Text="  ·  " Foreground="#4A4A54" FontSize="13"/>
                            <Run Text="{Binding SizeLabel, Mode=OneWay}" Foreground="#8A8A96" FontSize="13"/>
                        </TextBlock>

                        <!--
                            Download progress: only shown while State == Downloading.
                            A full-width progress bar is the lead element here (not a
                            "Downloading" text label) — the bar itself IS the status.
                            It stretches to the whole detail panel width via a
                            two-column Grid (filled star * percent / remaining star),
                            rather than the fixed-track PercentToWidthConverter the
                            narrow list cards use, so it fills the wide card properly.
                        -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,26"
                                    Visibility="{Binding State, Converter={StaticResource DownloadingToVisibilityConverter}}">
                            <TextBlock Text="{Binding DownloadProgressPercent, StringFormat={}{0:0}%}"
                                       FontSize="30" FontWeight="Bold" Foreground="#F5B72E" Margin="0,0,0,8"/>
                            <Border Height="10" CornerRadius="6" Background="#14FFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding DownloadProgressPercent, Converter={StaticResource PercentToStarConverter}}"/>
                                        <ColumnDefinition Width="{Binding DownloadProgressPercent, Converter={StaticResource PercentToRemainingStarConverter}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="6" Background="#F5B72E"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="WHAT'S NEW" FontSize="11" FontWeight="Bold"
                                           Foreground="#6E6E7D" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding PatchNotes}" FontSize="14" Foreground="#D6D6DE"
                                           TextWrapping="Wrap" LineHeight="24"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="5" Margin="0,26,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!--
                                Two action buttons, both controller-navigable: Left/Right
                                moves the highlight between them (SelectedButtonIndex,
                                driven from MainWindow via Updates.MoveButtonSelection),
                                A/Enter activates the highlighted one. The highlight ring
                                is an accent border that appears on whichever index is
                                selected, same visual language as the rest of the UI.
                            -->
                            <Border Grid.Column="0" CornerRadius="15" BorderThickness="2.5" Padding="1.5"
                                    BorderBrush="{Binding InstallButtonHighlight, ElementName=Root}">
                            <Button x:Name="InstallButton" Style="{StaticResource PrimaryActionButtonStyle}"
                                    Click="InstallButton_Click">
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="#06070B">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Download and install"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="ReadyToInstall">
                                                    <Setter Property="Text" Value="Install now"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                    <Setter Property="Text" Value="Downloading…"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Installed">
                                                    <Setter Property="Text" Value="Reinstall"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            </Border>

                            <Border Grid.Column="2" CornerRadius="15" BorderThickness="2.5" Padding="1.5"
                                    BorderBrush="{Binding RemindLaterButtonHighlight, ElementName=Root}">
                            <Button x:Name="RemindLaterButton" Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="RemindLaterButton_Click">
                                <TextBlock Text="Remind me later" FontSize="14" FontWeight="SemiBold" Foreground="#D6D6DE"/>
                            </Button>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Text="Press Tab or B to close" FontSize="12" FontWeight="Bold"
                   Foreground="#3A3A45" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"/>
    </Grid>
</UserControl>
