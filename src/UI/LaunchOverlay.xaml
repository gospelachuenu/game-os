<UserControl x:Class="UI.LaunchOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" x:Name="Root" Visibility="Collapsed" IsHitTestVisible="False">
    <!--
        "Swallow" launch takeover, standing in for plan.md §9.2's Smart Boot Splash.
        The panel starts positioned/sized exactly over the tile the user launched
        (set via Show(startRect, ...)) and animates its Margin to expand to fill the
        whole window — the tile itself visually grows into the full-screen splash,
        rather than a separate screen just appearing on top. A circular spinner (an
        Arc-shaped Path, rotated continuously) replaces a flat progress bar per the
        user's request. Never actually starts a process — see LaunchOverlay.xaml.cs.
    -->
    <Grid>
        <Border x:Name="Panel" ClipToBounds="True"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid>
                <Border Background="#06070B"/>
                <Border Background="{Binding ElementName=Root, Path=GameArt}"/>

                <!-- Flat dark scrim across the whole cover so the LAUNCHING text and
                     spinner stay readable no matter how bright the cover art is. -->
                <Border Background="#99000000"/>

                <!-- Vignette on top of that, darkening the edges further for depth. -->
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.55" RadiusX="0.9" RadiusY="0.9">
                            <GradientStop Color="#00000000" Offset="0.3"/>
                            <GradientStop Color="#B0000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,80,0,0" Opacity="0">
                    <TextBlock Text="{Binding ElementName=Root, Path=GameName}"
                               FontSize="34" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,26"/>

                    <Grid Width="56" Height="56" HorizontalAlignment="Center">
                        <!-- Faint full ring track -->
                        <Ellipse Width="56" Height="56" Stroke="#22FFFFFF" StrokeThickness="4"/>

                        <!-- Spinning arc: a partial ring (stroke dash trick) that
                             rotates continuously around the center. -->
                        <Ellipse x:Name="SpinnerArc" Width="56" Height="56" StrokeThickness="4"
                                 Stroke="{DynamicResource Theme.AccentPrimaryBrush}"
                                 StrokeDashArray="2.6 10"
                                 StrokeDashCap="Round">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" CenterX="28" CenterY="28"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- READY checkmark, hidden until the ready state. -->
                        <Path x:Name="ReadyCheck" Opacity="0"
                              Data="M 16,29 L 24,37 L 40,20"
                              Stroke="{DynamicResource Theme.AccentPrimaryBrush}"
                              StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Grid>

                    <TextBlock x:Name="StatusText" Text="LAUNCHING" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource Theme.AccentPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,18,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:1"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</UserControl>
