<UserControl x:Class="UI.GameDetailScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UI"
             mc:Ignorable="d" x:Name="Root" Visibility="Collapsed">
    <!--
        Game detail screen: shown when a game tile is selected, replacing the old
        straight-to-launch swallow. Keeps the home screen's ambient video playing
        behind a frosted/dark scrim (same treatment as UpdatesScreen — MainWindow
        hides only ContentGrid, not Ambient). Shows a large hero thumbnail, the
        game's info, a Play button (which fires the swallow launch), an update
        progress bar when an update is pending, and mock recommended graphics
        settings. Fully controller-navigable — see GameDetailScreen.xaml.cs.
    -->
    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:DownloadingToVisibilityConverter x:Key="DownloadingToVisibilityConverter"/>
        <local:PercentToStarConverter x:Key="PercentToStarConverter"/>
        <local:PercentToRemainingStarConverter x:Key="PercentToRemainingStarConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="SpecCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>
    </UserControl.Resources>

    <!-- Frosted dark scrim over the ambient video, same alpha as UpdatesScreen. -->
    <Grid Background="#66060709">
        <Grid MaxWidth="1180" Margin="60,44,60,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Left: hero thumbnail -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <Border x:Name="Thumbnail" CornerRadius="20" Height="300" Background="{Binding ArtBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="34" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <!--
                            When a cover image exists (GameEntry.ImageUrl resolved by
                            GameIconLoader) it fills the whole thumbnail edge-to-edge;
                            CornerRadius matches the outer border so the rounded corners
                            are preserved. With no image, the gradient ArtBrush behind
                            this (the outer Border's Background) shows through instead.
                        -->
                        <Border CornerRadius="20"
                                Visibility="{Binding IconSource, Converter={StaticResource NullToVisibilityConverter}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding IconSource}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Border>

                    <!-- Provider + status chips -->
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Border CornerRadius="8" Background="#14FFFFFF" Padding="12,6" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ProviderLabel}" FontSize="11" FontWeight="Bold" Foreground="#B8B8C2"/>
                        </Border>
                        <Border CornerRadius="8" Background="{DynamicResource Theme.AccentPrimaryFaintTintBrush}" Padding="12,6">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.AccentPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Right: info + settings -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <TextBlock Text="{Binding ProviderLabel}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.AccentPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding GameName}" FontSize="40" FontWeight="Bold"
                                   Foreground="White" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <!-- Update pending: progress bar -->
                        <Border CornerRadius="14" Background="#0FFFFFFF" Padding="20,16" Margin="0,0,0,22"
                                Visibility="{Binding HasUpdatePending, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="UPDATE IN PROGRESS" FontSize="11" FontWeight="Bold"
                                               Foreground="#F5B72E" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding UpdateProgressPercent, StringFormat={}{0:0}%}"
                                               FontSize="12" FontWeight="Bold" Foreground="#F5B72E" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Height="8" CornerRadius="5" Background="#14FFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding UpdateProgressPercent, Converter={StaticResource PercentToStarConverter}}"/>
                                            <ColumnDefinition Width="{Binding UpdateProgressPercent, Converter={StaticResource PercentToRemainingStarConverter}}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="5" Background="#F5B72E"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Recommended settings, chosen for the detected hardware -->
                        <TextBlock Text="RECOMMENDED FOR YOUR SYSTEM" FontSize="11" FontWeight="Bold"
                                   Foreground="#6E6E7D" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding RecommendedBasis}" FontSize="12" Foreground="#8A8A96"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Border Style="{StaticResource SpecCardStyle}" Margin="0,0,6,10">
                                <StackPanel>
                                    <TextBlock Text="GRAPHICS PRESET" FontSize="10" FontWeight="Bold" Foreground="#6E6E7D" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding RecommendedPreset}" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SpecCardStyle}" Margin="6,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="RESOLUTION" FontSize="10" FontWeight="Bold" Foreground="#6E6E7D" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding RecommendedResolution}" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SpecCardStyle}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="FRAME RATE" FontSize="10" FontWeight="Bold" Foreground="#6E6E7D" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding RecommendedFrameRate}" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SpecCardStyle}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="HDR" FontSize="10" FontWeight="Bold" Foreground="#6E6E7D" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding RecommendedHdr}" FontSize="17" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Bottom action bar: Play -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,28,0,0">
                <Border x:Name="PlayButtonHighlight" CornerRadius="15" BorderThickness="2.5" Padding="1.5" BorderBrush="Transparent">
                    <Button x:Name="PlayButton" Cursor="Hand" Click="PlayButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="12" Padding="46,15"
                                        Background="{DynamicResource Theme.AccentPrimaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶" FontSize="15" FontWeight="Bold" Foreground="#06070B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Play" FontSize="16" FontWeight="Bold" Foreground="#06070B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <TextBlock Text="Press B to go back" FontSize="12" FontWeight="Bold"
                           Foreground="#6E6E7D" VerticalAlignment="Center" Margin="24,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
