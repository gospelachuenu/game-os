<UserControl x:Class="UI.ControllerWizard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" x:Name="Root" Visibility="Collapsed">
    <!--
        Controller setup wizard: polls all 4 XInput slots live (via the same
        XInputGamepadReader used for real navigation) and shows connection status per
        slot. A slot moves from "connected" to "confirmed" once ANY button is pressed
        on it — genuine detection, not a static walkthrough. Opened on demand from the
        Guide Menu, not automatically on startup. Covers both Xbox controllers
        (native XInput) and PlayStation controllers (work identically AS LONG AS
        something — Steam, DS4Windows — is translating them into an XInput device;
        Windows does not do this natively, hence the guidance text).
    -->
    <Grid Background="#D2060709">
        <Border Width="640" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="20" Background="#F0121016" BorderBrush="#1FFFFFFF" BorderThickness="1"
                Padding="40,36">
            <StackPanel>
                <TextBlock Text="CONTROLLER SETUP" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource Theme.AccentPrimaryBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Turn on your controller and press any button to connect it."
                           FontSize="22" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,28"/>

                <ItemsControl ItemsSource="{Binding Slots, ElementName=Root}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Background="#0FFFFFFF" Padding="18,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#3A3A45"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Connected">
                                                        <Setter Property="Fill" Value="#F5B72E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Confirmed">
                                                        <Setter Property="Fill" Value="#33D17A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="White"
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Not connected"/>
                                                <Setter Property="Foreground" Value="#6E6E7D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Connected">
                                                        <Setter Property="Text" Value="Press any button"/>
                                                        <Setter Property="Foreground" Value="#F5B72E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Confirmed">
                                                        <Setter Property="Text" Value="Ready"/>
                                                        <Setter Property="Foreground" Value="#33D17A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border CornerRadius="10" Background="#0FFFFFFF" Padding="16" Margin="0,18,0,0">
                    <TextBlock Foreground="#B8B8C2" FontSize="12" TextWrapping="Wrap" LineHeight="18">
                        <Run Text="Xbox controllers connect directly."/>
                        <LineBreak/>
                        <Run Text="PlayStation (DualShock/DualSense) controllers need Steam or DS4Windows running in the background to be recognized."/>
                    </TextBlock>
                </Border>

                <TextBlock Text="Press Tab or B to close" FontSize="12" FontWeight="Bold"
                           Foreground="#3A3A45" Margin="0,20,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
